{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jjdiff",
  "version": "0.1.0",
  "identifier": "dev.jjdiff.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "jjdiff",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A fast, minimal diff viewer for Jujutsu repositories",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
